#download image from dockerhub
docker pull debian:buster

#docker process
docker ps (-a)

#show images
docker images

#show containers
docker contianer ls -a

#build another image using Dockerfile
docker build --tag (tag) (Dockefile_path) 

#make container using image
docker create (image_name)

#execute container
docker start (container_name)

#execute container
docker stop (container_name)

#enter into container
docker attatch (container_name)

#make container && execute container
docker run --rm -it (image or container name)
docker run --rm -it (image or container name) -c "bash /tmp

#copy file host -> container
docker cp [host 파일경로] [container name]:[container 내부 경로]

#copy file container -> host
docker cp [container name]:[container 내부 경로] [host 파일경로]

